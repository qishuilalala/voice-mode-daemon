{
  "name": "@voice-mode/daemon",
  "version": "0.1.0",
  "description": "本机回环语音加速守护进程：Kokoro 103 音色、Zipformer2/SenseVoice 双通道识别。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "voice-daemon": "./dist/cli.js",
    "voice-daemon-mcp": "dist/mcp-server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/security.test.ts test/model-cache.test.ts test/native-addon.test.ts test/server.test.ts test/cli.test.ts test/mcp-server.test.ts",
    "mcp": "node dist/mcp-server.js",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "check:api-doc": "node scripts/check-api-doc.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@voice-mode/core": "file:../../vendor/voice-mode-core-0.1.0.tgz",
    "sherpa-onnx-node": "1.13.6",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qishuilalala/voice-mode-daemon.git",
    "directory": "packages/voice-daemon"
  },
  "homepage": "https://github.com/qishuilalala/voice-mode-daemon#readme",
  "author": {
    "name": "qishuilalala",
    "url": "https://github.com/qishuilalala"
  },
  "keywords": [
    "voice",
    "tts",
    "asr",
    "kokoro",
    "sherpa-onnx",
    "zipformer",
    "sensevoice",
    "local",
    "offline",
    "daemon"
  ],
  "devDependencies": {
    "@types/ws": "^8.18.2"
  }
}
